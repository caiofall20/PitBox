# E-mail da recuperação de senha (SMTP). Gratuitos: Gmail com "senha de app", Brevo (300/dia), Resend (3.000/mês)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
MAIL_FROM=PitBox <voce@gmail.com>
