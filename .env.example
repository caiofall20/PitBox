# Copie para .env e preencha antes de subir
DOMAIN=pitbox.seudominio.com.br
POSTGRES_PASSWORD=troque-esta-senha-do-banco
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria-com-mais-de-24-caracteres
ADMIN_NAME=Seu nome
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha-do-admin
# Login com Google (opcional): ID do cliente OAuth "Aplicativo da Web". Vazio = botão escondido
