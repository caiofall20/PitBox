PORT=3333
# Supabase: Project Settings > Database > Connection string (URI).
# Prefira a conexão direta (porta 5432) ou Session pooler — não use Transaction pooler com este app.
# Ex.: postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://pitbox:pitbox@localhost:5432/pitbox
# true no Supabase / Neon / qualquer Postgres gerenciado com SSL
DATABASE_SSL=false
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
# URL do front na Vercel (sem barra no final). Várias origens: separe por vírgula.
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=/uploads
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@pitbox.app
ADMIN_PASSWORD=troque-esta-senha

# Endereço do app (link do e-mail de nova senha) = URL da Vercel
APP_URL=http://localhost:5173
# E-mail (recuperação de senha). Sem SMTP_HOST o link aparece no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PitBox <no-reply@seu-dominio.com>

# Login com Google (opcional)
GOOGLE_CLIENT_ID=

# Fotos persistentes (recomendado em produção Free): Storage do Supabase — 1 GB grátis.
# Project Settings > API: Project URL + service_role (secret). Nunca exponha no frontend.
# Com as duas preenchidas, as fotos NÃO ficam no disco da Render (sobrevivem a restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pitbox-photos
